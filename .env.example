# Copy to .env and fill in. Never commit .env. See docs/needs.md section B6.

# Tiger Cloud (Tiger Data)
TIGERDATA_PROJECT_ID=
TIGERDATA_ACCESS_KEY=
TIGERDATA_SECRET_KEY=
TIGER_PRIMARY_SERVICE_ID=
TEMPO_DATABASE_URL=postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require

# Local Docker DB for tests (scripts/dev_db.sh)
TEMPO_TEST_DATABASE_URL=postgres://postgres:tempo@localhost:5433/postgres

# Vultr
VULTR_API_KEY=
VULTR_REGION=ewr
VULTR_WORKER_PLAN=vc2-1c-1gb
VULTR_WORKER_SNAPSHOT_ID=
VULTR_SSHKEY_ID=

# Tempo
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
PRICE_PROVIDER=APXMIDP
BATTERY_CAPACITY_MWH=2
BATTERY_POWER_MW=1
BATTERY_RT_EFFICIENCY=0.90
BATTERY_CYCLE_COST_GBP=20
MID_AVAILABILITY_DELAY_MIN=10

# Timing audit fork layout: 'shared' (1 fork per audit, fits Tiger free tier's 2-service limit)
# or 'per_shift' (5 forks per audit, needs a raised service limit)
TEMPO_AUDIT_FORKS=shared

# Set to 1 to run tests that hit real Tiger / Vultr / Elexon
TEMPO_LIVE=0
